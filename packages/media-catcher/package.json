{
  "name": "media-catcher-userscript",
  "version": "2.4.0",
  "description": "Catch and save Panopto JSON & Zoom VTT transcripts with GUI - Modular UserScript",
  "main": "src/main.js",
  "scripts": {
    "build": "node build/build.js",
    "build:dev": "cross-env BUILD_MODE=development node build/build.js",
    "build:prod": "cross-env BUILD_MODE=production node build/build.js",
    "dev": "npm run build:dev && echo 'Development build complete!'",
    "watch": "nodemon --watch src --exec \"npm run build:dev\"",
    "test": "node --test",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" --fix",
    "lint:build": "eslint \"build/**/*.js\"",
    "lint:all": "npm run lint && npm run lint:build",
    "format": "prettier --write \"src/**/*.js\"",
    "format:build": "prettier --write \"build/**/*.js\"",
    "format:all": "prettier --write \"src/**/*.js\" \"build/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"build/**/*.js\" \"tests/**/*.js\"",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "prebuild": "npm run clean",
    "prebuild:prod": "npm run clean"
  },
  "keywords": [
    "userscript",
    "tampermonkey",
    "panopto",
    "zoom",
    "video",
    "transcript",
    "caption",
    "download"
  ],
  "author": "Automation Toolkit contributors",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.50.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "terser": "^5.31.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mythic3011/automation-toolkit.git",
    "directory": "packages/media-catcher"
  }
}
